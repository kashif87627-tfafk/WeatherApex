<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌤️ Background Image -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/weatherbgg"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/watermarkText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="8dp"
        android:text="@string/kashif_md_n23311a66m8_snist_hyd"
        android:textColor="@color/black"
        android:textSize="12sp"
    android:textStyle="bold"
    android:gravity="end"
    android:lineSpacingExtra="2dp"
    android:fontFamily="sans-serif-medium"
    android:background="@android:color/transparent"/>


    <!-- 🌦️ App Title -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp"
        android:background="@drawable/edittext_glass"
        android:text="@string/weather"
        android:textColor="@color/white"
        android:textSize="52sp"
        android:textStyle="bold" />


    <!-- 🏙️ City Name Input -->
    <AutoCompleteTextView
        android:id="@+id/cityName"
        android:layout_width="270dp"
        android:layout_height="72dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:background="@drawable/edittext_glass"
        android:hint="@string/enter_city"
        android:padding="14dp"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textColorHint="#FFEB3B"
        android:textSize="20sp"
        android:elevation="8dp" />

    <!-- 🔍 Search Button -->
    <Button
        android:id="@+id/search"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/cityName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_modern"
        android:padding="14dp"
        android:text="Search City"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="10dp"
        tools:ignore="HardcodedText" />

    <!-- 📍 Fetch Current Location Button -->
    <Button
        android:id="@+id/fetchLocation"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/search"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_modern"
        android:drawableLeft="@drawable/ic_gps"
        android:drawablePadding="12dp"
        android:paddingStart="40dp"
        android:paddingEnd="20dp"
        android:text="Use Current Location"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="10dp"
        tools:ignore="HardcodedText" />

</RelativeLayout>
